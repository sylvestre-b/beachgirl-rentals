{
  "name": "beachgirl-rentals",
  "version": "2.0.0",
  "private": true,
  "description": "Beach Girl Property Rentals — vacation rental site for Old Orchard Beach, ME.",
  "scripts": {
    "images": "node scripts/optimize-images.js",
    "build": "npm run images && node build.js",
    "lint": "eslint js scripts build.js calendar.js",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"**/*.{js,css,html,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,css,html,json,md}\"",
    "validate:html": "html-validate \"*.html\"",
    "lhci": "lhci autorun --config=./lighthouse.config.cjs",
    "test": "npm run lint && npm run format:check && npm run validate:html",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^12.0.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.13.0",
    "@playwright/test": "^1.44.0",
    "eslint": "^8.57.0",
    "html-validate": "^8.18.0",
    "http-server": "^14.1.1",
    "prettier": "^3.2.5",
    "sharp": "^0.33.4",
    "wait-on": "^7.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
